# AWS/Wasabi S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_ENDPOINT=s3.eu-west-1.wasabisys.com
AWS_REGION=eu-west-1
S3_BUCKET=jigu

# Server Configuration
PORT=5000
REQUIRE_AUTH=false

# Blender Automation Configuration
# Path to the Blender executable on this machine.
# Windows default: C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
# macOS default:   /Applications/Blender.app/Contents/MacOS/Blender
# Linux default:   /usr/bin/blender
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe

# Maximum time (in milliseconds) to wait for a single Blender generation job.
# Default: 300000 (5 minutes)
GENERATION_TIMEOUT_MS=300000

# Maximum number of Blender processes that may run simultaneously.
# Additional jobs are queued and processed as slots become available.
# Default: 3
MAX_CONCURRENT_JOBS=3
